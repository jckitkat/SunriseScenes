{
  "name": "sunrise-scenes",
  "productName": "Sunrise Scenes",
  "version": "0.4.0",
  "private": true,
  "description": "Visual scene editor that compiles to Project Sunrise mission scripts (Lua).",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "desktop": "electron .",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "smoke": "vite build && node scripts/smoke.mjs",
    "dist": "node scripts/dist.mjs",
    "dist:x64": "node scripts/dist.mjs --arch=x64",
    "dist:linux": "node scripts/dist.mjs --platform=linux",
    "dist:win": "node scripts/dist.mjs --platform=win32"
  },
  "dependencies": {
    "luaparse": "^0.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.5.1",
    "vite": "^8.3.2"
  }
}
